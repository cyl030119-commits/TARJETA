
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pollería Rodríguez - Pagos</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 24px 16px;
  font-family: Arial, sans-serif;
  background: #fff4fa;
  color: #fff;
}
main { max-width: 390px; margin: auto; }
.card {
  padding: 24px;
  border-radius: 26px;
  background: linear-gradient(145deg,#f58bc8,#d52d8b,#a50959);
  box-shadow: 0 12px 28px #9c16552b;
}
.brand { font-size: 12px; letter-spacing: 2px; }
h1 { font-size: 25px; margin: 12px 0 26px; }
.chip {
  width: 48px; height: 36px;
  border-radius: 8px;
  background: linear-gradient(135deg,#ffe8a3,#c49a43);
  margin-bottom: 26px;
}
.label { font-size: 11px; letter-spacing: 1.5px; opacity: .9; }
.clabe {
  margin: 10px 0 26px;
  font-size: 23px;
  font-weight: bold;
  overflow-wrap: anywhere;
}
.footer {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
}
.owner { font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
#qr { width: 100px; height: 100px; background: white;
  padding: 5px; border-radius: 9px; }
button {
  width: 100%; padding: 16px; margin-top: 13px;
  border: 0; border-radius: 13px;
  font-size: 16px; font-weight: bold; cursor: pointer;
}
.copy { background: #b20d64; color: white; }
.wa { background: #168653; color: white; }
#status { color: #70214b; text-align: center; font-size: 14px; }
</style>
</head>
<body>
<main>
  <section class="card">
    <div class="brand">POLLERÍA RODRÍGUEZ</div>
    <h1>Mercado Pago</h1>
    <div class="chip"></div>
    <div class="label">CLABE INTERBANCARIA</div>
    <div class="clabe" id="clabeVista"></div>
    <div class="footer">
      <div>
        <div class="label">TITULAR</div>
        <div class="owner" id="titularVista"></div>
      </div>
      <img id="qr" alt="QR para abrir esta tarjeta">
    </div>
  </section>
  <button class="copy" id="copyBtn">📋 Copiar CLABE</button>
  <button class="wa" id="waBtn">Compartir por WhatsApp</button>
  <p id="status" role="status"></p>
</main>
<script>
const CLABE = "722969016055740870";
const TITULAR = "Cristian Jesús Cano Rodríguez";

document.getElementById("clabeVista").textContent =
  CLABE.replace(/(\d{3})(?=\d)/g, "$1 ");
document.getElementById("titularVista").textContent = TITULAR;

document.getElementById("qr").src =
  "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=" +
  encodeURIComponent(location.href);

document.getElementById("copyBtn").addEventListener("click", async () => {
  const status = document.getElementById("status");
  try {
    await navigator.clipboard.writeText(CLABE);
    status.textContent = "¡CLABE copiada! Ya puedes pegarla en tu banco.";
  } catch {
    status.textContent = "No se pudo copiar automáticamente. Mantén pulsada la CLABE para copiarla.";
  }
});

document.getElementById("waBtn").addEventListener("click", () => {
  const texto = `Datos para transferencia\nPollería Rodríguez\nTitular: ${TITULAR}\nCLABE: ${CLABE}\nTarjeta: ${location.href}`;
  window.open("https://wa.me/?text=" + encodeURIComponent(texto), "_blank");
});
</script>
</body>
</html>
